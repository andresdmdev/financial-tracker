---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import TransactionsPanel from '@/components/transactions/TransactionsPanel';
import TransactionsFilters from '@/components/transactions/TransactionsFilters';
import { getLookups, listTransactions, type TransactionFilters } from '@/lib/queries/transactions';
import { getDeclaredBalances } from '@/lib/queries/dashboard';
import type { TxDirection, TxStatus } from '@/lib/database.types';

const params = Astro.url.searchParams;

/**
 * Reads a query parameter, treating blank values as absent so an untouched
 * filter dropdown does not narrow the results.
 */
function param(name: string): string | undefined {
  const value = params.get(name);
  return value === null || value.trim() === '' ? undefined : value.trim();
}

const page = Number(param('page') ?? '1') || 1;

const filters: TransactionFilters = {
  from: param('from'),
  to: param('to'),
  categoryId: param('category'),
  accountId: param('account'),
  direction: param('direction') as TxDirection | undefined,
  status: param('status') as TxStatus | undefined,
  tag: param('tag'),
  search: param('q'),
  page,
};

const [lookups, result, balances] = await Promise.all([
  getLookups(Astro.locals.supabase),
  listTransactions(Astro.locals.supabase, filters),
  getDeclaredBalances(Astro.locals.supabase),
]);

/** Active filters minus the page, so pagination links can re-apply them. */
const filterParams = new URLSearchParams(params);
filterParams.delete('page');
const filterQuery = filterParams.toString();

const initialFilters: Record<string, string> = {
  from: param('from') ?? '',
  to: param('to') ?? '',
  category: param('category') ?? '',
  account: param('account') ?? '',
  direction: param('direction') ?? '',
  status: param('status') ?? '',
  tag: param('tag') ?? '',
  q: param('q') ?? '',
};
---

<DashboardLayout title="Transacciones" heading="Transacciones">
  <div class="space-y-8">
    <TransactionsFilters lookups={lookups} initial={initialFilters} client:load />

    <TransactionsPanel
      items={result.items}
      lookups={lookups}
      balances={balances}
      total={result.total}
      page={result.page}
      pageSize={result.pageSize}
      filterQuery={filterQuery}
      client:load
    />
  </div>
</DashboardLayout>
