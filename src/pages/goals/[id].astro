---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import SectionCard from '@/components/SectionCard.astro';
import StatTile from '@/components/StatTile.astro';
import GoalProgressChart from '@/components/charts/GoalProgressChart';
import GoalAllocationEditor from '@/components/goals/GoalAllocationEditor';
import GoalActions from '@/components/goals/GoalActions';
import MemberMovementForm from '@/components/goals/MemberMovementForm';
import ExchangeRates from '@/components/dashboard/ExchangeRates';
import GoalTabs from '@/components/goals/GoalTabs.astro';
import { getOpenGoalTaskCount } from '@/lib/queries/goal-tasks';
import {
  authorLabel,
  getGoal,
  getGoalAllocations,
  getGoalMovements,
  getGoalShares,
  toProgressSeries,
  type GoalMovement,
} from '@/lib/queries/goals';
import { getGoalProgress } from '@/lib/queries/dashboard';
import { getLookups } from '@/lib/queries/transactions';
import { Badge } from '@/components/ui/badge';
import { formatDate, formatLocal, formatPercent, formatUsd } from '@/lib/format';

const { id } = Astro.params;
const { supabase, role } = Astro.locals;
const isOwner = role === 'owner';

if (id === undefined) return Astro.redirect('/goals');

const goal = await getGoal(supabase, id);
if (goal === null) return Astro.redirect('/goals');

const [movements, progressList, allocations, lookups, shares, openTaskCount] = await Promise.all([
  getGoalMovements(supabase, id),
  getGoalProgress(supabase),
  isOwner ? getGoalAllocations(supabase, id) : Promise.resolve([]),
  isOwner ? getLookups(supabase) : Promise.resolve(null),
  isOwner ? getGoalShares(supabase, id) : Promise.resolve([]),
  getOpenGoalTaskCount(supabase, id),
]);

const progress = progressList.find((item) => item.goalId === id) ?? null;
const series = toProgressSeries(movements);
const recent = [...movements].reverse();

const accumulated = progress?.currentAmountUsd ?? 0;
const allocated = allocations.reduce((sum, item) => sum + item.amountUsd, 0);

const STATUS_LABEL = {
  active: 'Activa',
  completed: 'Completada',
  abandoned: 'Abandonada',
} as const;

const FALLBACK_TITLE = {
  income: 'Ingreso',
  expense: 'Gasto',
  transfer: 'Aporte',
} as const;

/**
 * Headline of a movement row. A guest cannot read the owner's accounts or
 * categories, so those joins come back null and the row falls back to the
 * direction alone.
 */
function movementTitle(movement: GoalMovement): string {
  if (movement.direction === 'transfer' && isOwner) {
    return `Aporte: ${movement.accountName} → ${movement.toAccountName ?? '—'}`;
  }
  return movement.categoryName ?? FALLBACK_TITLE[movement.direction];
}

/**
 * Secondary line: date, then the account for the owner, where the guest paid
 * from, and the original local amount when there is one.
 */
function movementMeta(movement: GoalMovement): string {
  const parts = [formatDate(movement.occurredOn)];
  if (isOwner) parts.push(movement.accountName);
  if (movement.paymentMethod !== null) parts.push(`Pagado con ${movement.paymentMethod}`);
  if (movement.amountLocal !== null) {
    parts.push(formatLocal(movement.amountLocal, movement.localCurrency));
  }
  return parts.join(' · ');
}
---

<DashboardLayout title={goal.name}>
  <div class="space-y-6">
    <header class="space-y-2">
      {
        isOwner && (
          <a
            href="/goals"
            class="inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
          >
            ← Metas de ahorro
          </a>
        )
      }
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-xl font-semibold tracking-tight sm:text-2xl">{goal.name}</h1>
          <span class="rounded-full border border-border px-2 py-0.5 text-xs text-muted-foreground">
            {STATUS_LABEL[goal.status]}
          </span>
        </div>
        {
          isOwner && lookups !== null ? (
            <GoalActions
              goalId={goal.id}
              name={goal.name}
              targetAmountUsd={goal.targetAmountUsd}
              targetDate={goal.targetDate}
              accountId={goal.accountId}
              status={goal.status}
              notes={goal.notes}
              lookups={lookups}
              shares={shares}
              movementCount={movements.length}
              client:load
            />
          ) : (
            <MemberMovementForm goalId={goal.id} client:load />
          )
        }
      </div>
      {
        goal.notes !== null ? (
          <p class="max-w-2xl text-sm text-muted-foreground">{goal.notes}</p>
        ) : (
          isOwner && (
            <p class="max-w-2xl text-sm text-muted-foreground/70">
              Sin descripción. Puedes agregarla al editar la meta.
            </p>
          )
        )
      }
      <ExchangeRates variant="compact" client:load />
      <GoalTabs goalId={goal.id} active="summary" openTaskCount={openTaskCount} />
    </header>

    <div class:list={['grid gap-4 sm:grid-cols-2', isOwner ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
      <StatTile label="Acumulado" value={formatUsd(accumulated)} accent />
      {
        isOwner && (
          <StatTile
            label="Objetivo"
            value={goal.targetAmountUsd === null ? '—' : formatUsd(goal.targetAmountUsd)}
            hint={goal.targetDate === null ? undefined : `Para ${formatDate(goal.targetDate)}`}
          />
        )
      }
      <StatTile
        label="Progreso"
        value={progress?.progressRatio == null ? '—' : formatPercent(progress.progressRatio)}
        hint={goal.targetAmountUsd === null
          ? 'Sin objetivo definido'
          : `Faltan ${formatUsd(Math.max(0, goal.targetAmountUsd - accumulated))}`}
      />
      <StatTile
        label="Gastado desde la meta"
        value={formatUsd(progress?.spentUsd ?? 0)}
        hint={`Aportado ${formatUsd(progress?.contributedUsd ?? 0)}`}
      />
    </div>

    <SectionCard
      title="Progreso en el tiempo"
      subtitle="Saldo acumulado tras cada movimiento. Los escalones son los aportes."
    >
      <GoalProgressChart data={series} targetUsd={goal.targetAmountUsd} client:visible />
    </SectionCard>

    {
      isOwner && lookups !== null && (
        <SectionCard
          title="Dónde está el dinero"
          subtitle="Reparto manual: las transacciones dicen de dónde salió, no dónde está hoy."
        >
          <GoalAllocationEditor
            goalId={goal.id}
            accumulatedUsd={accumulated}
            allocations={allocations}
            accounts={lookups.accounts}
            client:load
          />
        </SectionCard>
      )
    }

    <SectionCard title="Movimientos" subtitle={`${movements.length} en total`}>
      {
        recent.length === 0 ? (
          <p class="py-8 text-center text-sm text-muted-foreground">
            Esta meta no tiene movimientos todavía.
          </p>
        ) : (
          <ul class="divide-y divide-border">
            {recent.map((movement) => {
              const author = authorLabel(movement);
              return (
                <li class="flex items-start justify-between gap-4 py-3 text-sm first:pt-0">
                  <div class="min-w-0">
                    <span class="block font-medium">{movementTitle(movement)}</span>
                    <span class="block text-xs text-muted-foreground">{movementMeta(movement)}</span>
                    {movement.notes !== null && (
                      <p class="mt-1 text-xs text-muted-foreground">{movement.notes}</p>
                    )}
                    {movement.tags.length > 0 && (
                      <div class="mt-1.5 flex flex-wrap gap-1.5">
                        {movement.tags.map((tag) => (
                          <Badge variant="outline" className="font-normal">
                            {tag}
                          </Badge>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="shrink-0 text-right">
                    <span
                      class:list={[
                        'tabular block text-base font-medium whitespace-nowrap sm:text-sm',
                        movement.direction === 'expense' ? 'text-destructive' : 'text-success',
                      ]}
                    >
                      {movement.direction === 'expense' ? '−' : '+'}
                      {formatUsd(movement.amountUsd)}
                    </span>
                    {author !== null && (
                      <span
                        class="mt-0.5 block text-[11px] text-muted-foreground"
                        title={movement.createdByEmail ?? undefined}
                      >
                        {author}
                      </span>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }
    </SectionCard>

    {
      isOwner && allocations.length > 0 && Math.abs(accumulated - allocated) >= 0.01 && (
        <p class="rounded-xl border border-border bg-card px-4 py-3 text-sm text-muted-foreground">
          El reparto suma{' '}
          <span class="tabular font-medium text-foreground">{formatUsd(allocated)}</span> pero la
          meta acumula{' '}
          <span class="tabular font-medium text-foreground">{formatUsd(accumulated)}</span>. La
          diferencia no es un error del sistema: o moviste dinero sin registrarlo, o falta ubicar
          una parte.
        </p>
      )
    }
  </div>
</DashboardLayout>
