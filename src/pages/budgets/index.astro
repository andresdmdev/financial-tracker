---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import BudgetsPanel from '@/components/budgets/BudgetsPanel';
import { getBudgetVsActual } from '@/lib/queries/dashboard';
import { getLookups } from '@/lib/queries/transactions';
import { toMonthKey } from '@/lib/format';

const requested = Astro.url.searchParams.get('month');
const periodMonth =
  requested !== null && /^\d{4}-\d{2}$/.test(requested) ? `${requested}-01` : toMonthKey();

const { supabase } = Astro.locals;

const [items, lookups] = await Promise.all([
  getBudgetVsActual(supabase, periodMonth),
  getLookups(supabase),
]);
---

<DashboardLayout title="Presupuestos" heading="Presupuestos">
  <BudgetsPanel
    periodMonth={periodMonth}
    items={items}
    categories={lookups.categories}
    client:load
  />
</DashboardLayout>
