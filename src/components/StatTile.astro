---
import { Card, CardContent } from '@/components/ui/card';

interface Props {
  label: string;
  value: string;
  hint?: string;
  tone?: 'neutral' | 'positive' | 'negative';
  accent?: boolean;
}

const { label, value, hint, tone = 'neutral', accent = false } = Astro.props;

const toneClass = {
  neutral: 'text-foreground',
  positive: 'text-success',
  negative: 'text-destructive',
}[tone];
---

<Card className={`gap-0 py-4 ${accent ? 'border-primary/25 bg-primary/6' : ''}`}>
  <CardContent className="px-4">
    <p class="text-xs font-medium text-muted-foreground">{label}</p>
    <p class:list={['tabular mt-1.5 text-2xl font-semibold tracking-tight', toneClass]}>{value}</p>
    {hint && <p class="mt-1 text-xs text-muted-foreground">{hint}</p>}
  </CardContent>
</Card>
