# Supabase project URL and anonymous key.
# The anon key is safe to expose to the browser: every table is protected by RLS.
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Only this Google account is allowed past the auth middleware.
ADMIN_EMAIL="<tu-cuenta-de-google>"

# Base URL used to build the OAuth redirect target.
PUBLIC_SITE_URL="http://localhost:4321"

# Server-only key with full access, bypasses RLS.
# Used exclusively by scripts/import-sheet.ts. NEVER expose it to the browser
# and never add it to Vercel unless a server task actually needs it.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
